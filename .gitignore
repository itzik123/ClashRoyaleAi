FodyWeavers.xsd

# Python & Virtual Environment
venv/
__pycache__/
*.pyc

# Machine Learning & Outputs
*.pth
runs/
replays/

# Compiled Python Extensions
*.pyd
*.so

build_python/
build_test/
# The CMake tree a plain `cmake -S . -B build` produces. Its two siblings above
# were ignored and this one was not, so configuring the engine left 1331
# untracked files sitting in `git add -A`'s path -- including CMakeCache.txt,
# which pins absolute machine paths and is actively wrong to share.
build/
# Local-only evidence kept beside the dead pre-speed-fix checkpoints. The
# measured numbers live in archive_pre_speed_fix/README.md; these are the raw
# files behind them, and follow the same no-replays-in-git rule as replays/.
replays_sample/
*.pth.bak

# Generated experiment artifacts: BC / expert-iteration label datasets.
# Regenerable (expert_iteration.py --collect, ~7 min for 80 episodes) and
# large, same reasoning as *.pth above.
*.npz

# Generated paired replay JSONs from make_replays.py -- regenerable, and large
# (each is 1-4 MB of per-tick board state).
replays_e3/
replays_search/
# make_replays.py --teacher-debug output. Same rule: regenerable, and larger
# still because each decision carries up to five predicted boards.
replays_teacher_debug/

# Session working directories: isolated trainer CWDs and checkpoint backups
_runs/
_session_backup_*/

# --- data / run artefacts (2026-08-17 housekeeping) ------------------------
# NOTE ON *.json, deliberately NOT blanket-ignored: eight tracked .json files
# are CONFIG or FROZEN TEST FIXTURES, not data --
#   perception/config/profile_gpg_1920x1080.json   calibration profile
#   perception/mapping/card_map.json               card id mapping
#   perception/tests/assets/replay_ep1026.json     frozen replay fixture
#   perception/config/templates/.../digits.json    OCR templates
#   perception/tools/labels_549x976.json           hand labels
#   CMakePresets.json / .vscode / .claude          build + editor config
# Ignoring *.json wholesale would untrack all of them and break calibration,
# card mapping and the perception suite. The DATA-shaped json already is
# ignored by path (replays/, replays_e3/, replays_search/).
*.jsonl
replay_keep_26hog/

# Tensorboard event files, wherever they land (runs/ already covers the usual
# location; this catches a stray one written elsewhere).
*.tfevents*
events.out.tfevents*

# Recorded video. perception/.gitignore already ignores assets/recordings/;
# this is the belt-and-braces rule for anything captured outside it.
*.mp4
*.avi
*.mkv
*.mov

# Training console logs from long runs (kept locally, regenerable output).
training_*.log
training_*.log.err

# Standalone audit instrument binaries (tools/audit/build.ps1 output)
tools/audit/bin/

# Viewer development fixtures (~9 MB, regenerable and SEEDED, so a fresh
# checkout reproduces them byte-for-byte):
#   python_ai/venv/Scripts/python.exe tools/viewer_fixtures/make_fixtures.py
web/fixtures/

# Scratch dir for engine audits and the side-by-side bench: extracted video
# frames, cropped clips, compiled ELF probes, and the multi-MB payloads the
# viewer embeds. 280 MB of it was staged on 2026-08-26 before this rule
# existed. Everything in it is REGENERABLE -- the sources that produce it are
# tracked, in perception/tools/side_by_side/, and that README has the commands.
.vid/
